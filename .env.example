# Copia este archivo con el nombre .env y llena tus valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Secreto para firmar los tokens de sesión (JWT). Distinto de DJANGO_SECRET_KEY. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# True en tu computador. En producción: False
DJANGO_DEBUG=True

# Base de datos PostgreSQL
DB_NAME=tienda_studio_sd
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Solo para producción (cuando el sitio se publique con https) ---
# DJANGO_ALLOWED_HOSTS=mitienda.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mitienda.com
# DJANGO_CORS_ORIGINS=https://mitienda.com
# DJANGO_USAR_HTTPS=True
